{
	"name": "spendit-api",
	"version": "1.0.0",
	"description": "Database management API for Spendit",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/a3drian/spendit.git"
	},
	"author": "a3drian",
	"license": "ISC",
	"private": true,
	"main": "index.js",
	"engines": {
		"node": "22.x",
		"npm": "11.x"
	},
	"scripts": {
		"prebuild": "npm run type:check && npm run lint",
		"lint:prettier": "npx prettier --check .",
		"lint:ts": "eslint .",
		"lint": "npm run lint:ts",
		"build:tsc": "npm run type:check && tsc",
		"build": "npm run build:tsc",
		"start:debug": "npm run type:check && npm run ts:node:debug",
		"start:tsc": "npm run type:check && npm run ts:node:dev",
		"ts:node:dev": "tsx watch src/index.ts",
		"ts:node:debug": "tsx watch --inspect src/index.ts",
		"type:check": "tsc --noEmit --project .",
		"deploy": "npm run build && node build",
		"start": "node src/index.js"
	},
	"dependencies": {
		"@a3drian/spendit-shared": "file:./a3drian-spendit-shared.tgz",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"firebase-admin": "^13.10.0",
		"mongoose": "^9.6.2"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^25.9.1",
		"@typescript-eslint/eslint-plugin": "^8.59.4",
		"@typescript-eslint/parser": "^8.59.4",
		"eslint": "^10.4.0",
		"globals": "^17.6.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4"
	}
}
